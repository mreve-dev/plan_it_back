// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema


datasource db {
  provider = "mysql"
}

generator client {
  provider     = "prisma-client"
  output       = "generated/prisma"
  moduleFormat = "cjs"
}

enum RoleEnum {
  benevole
  admin
}

model User {
  id                   Int       @id @default(autoincrement())
  firstname            String    @db.VarChar(45)
  lastname             String    @db.VarChar(45)
  email                String    @unique @db.VarChar(45)
  password             String    @db.VarChar(255)
  date_of_birth        DateTime? @db.Date
  role                 RoleEnum
  createdAt            DateTime  @default(now()) @db.DateTime(45)
  updatedAt            DateTime  @updatedAt @db.DateTime(45)
  mustChangePassword   Boolean   @default(true) @db.TinyInt
  isOnboarded          Boolean   @default(false) @db.TinyInt
  resetPasswordToken   String?   @db.VarChar(255)
  resetPasswordExpires DateTime? @db.DateTime(45)

  evnts           Evnt[]             @relation("EventCreator")
  notifications   Notification[]
  userHasMissions User_Has_Mission[]
  userHasSkills   User_has_Skill[]
  updatedEvent    Evnt[]             @relation("EventUpdater")
  missions        Mission[]          @relation("MissionCreator")
  updatedMissions Mission[]          @relation("MissionUpdater")
  updatedSlots    MissionSlot[]      @relation("SlotUpdater")
}

model Evnt {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(45)
  start_date  DateTime @db.Date
  end_date    DateTime @db.Date
  start_hour  DateTime @db.Time(0)
  end_hour    DateTime @db.Time(0)
  location    String?  @db.VarChar(45)
  description String   @db.VarChar(255)
  categoryId  Int      @db.Int
  creatorId   Int      @db.Int
  updatedById Int?     @db.Int
  documentId  Int?     @db.Int
  createdAt   DateTime @default(now()) @db.DateTime(45)
  updatedAt   DateTime @updatedAt @db.DateTime(45)

  creator  User      @relation("EventCreator", fields: [creatorId], references: [id])
  updater  User?     @relation("EventUpdater", fields: [updatedById], references: [id])
  category Category  @relation(fields: [categoryId], references: [id])
  document Document? @relation(fields: [documentId], references: [id])

  missions         Mission[]
  eventHasDocument Event_Has_Document[]
}

model Mission {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(45)
  description String   @db.VarChar(45)
  eventId     Int      @db.Int
  creatorId   Int      @db.Int
  createdAt   DateTime @default(now()) @db.DateTime(45)
  updatedAt   DateTime @updatedAt @db.DateTime(45)
  updatedById Int?     @db.Int

  event Evnt @relation(fields: [eventId], references: [id], onDelete: Cascade)

  creator User  @relation("MissionCreator", fields: [creatorId], references: [id])
  updater User? @relation("MissionUpdater", fields: [updatedById], references: [id])

  missionHasSkills Mission_has_Skill[]
  missionSlots     MissionSlot[]
}

model MissionSlot {
  id             Int      @id @default(autoincrement())
  date           DateTime @db.Date
  start_hour     DateTime @db.Time(0)
  end_hour       DateTime @db.Time(0)
  max_volunteers Int      @db.Int
  missionId      Int      @db.Int
  updatedById    Int?     @db.Int
  createdAt      DateTime @default(now()) @db.DateTime(45)
  updatedAt      DateTime @updatedAt @db.DateTime(45)

  updater User? @relation("SlotUpdater", fields: [updatedById], references: [id])

  mission         Mission            @relation(fields: [missionId], references: [id], onDelete: Cascade)
  userHasMissions User_Has_Mission[]
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(45)
  createdAt DateTime @default(now()) @db.DateTime(45)
  updatedAt DateTime @updatedAt @db.DateTime(45)

  evnts Evnt[]
}

model Document {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(45)
  url       String   @db.VarChar(45)
  createdAt DateTime @default(now()) @db.DateTime(45)
  updatedAt DateTime @updatedAt @db.DateTime(45)

  evnts            Evnt[]
  eventHasDocument Event_Has_Document[]
}

model Notification {
  id        Int      @id @default(autoincrement())
  message   String   @db.VarChar(255)
  date      DateTime @db.Date
  is_read   Boolean  @db.TinyInt
  userId    Int      @db.Int
  createdAt DateTime @default(now()) @db.DateTime(45)
  updatedAt DateTime @updatedAt @db.DateTime(45)

  user User @relation(fields: [userId], references: [id])
}

model Skill {
  id               Int                 @id @default(autoincrement())
  name             String              @unique @db.VarChar(45)
  createdAt        DateTime            @default(now()) @db.DateTime(45)
  updatedAt        DateTime            @updatedAt @db.DateTime(45)
  userHasSkills    User_has_Skill[]
  missionHasSkills Mission_has_Skill[]
}

model User_has_Skill {
  userId    Int @db.Int
  skillId   Int @db.Int
  createdAt   DateTime @default(now()) @db.DateTime(45)

  user  User  @relation(fields: [userId], references: [id])
  skill Skill @relation(fields: [skillId], references: [id])

  @@id([userId, skillId])
}

model Mission_has_Skill {
  missionId Int @db.Int
  skillId   Int @db.Int
  createdAt   DateTime @default(now()) @db.DateTime(45)

  mission Mission @relation(fields: [missionId], references: [id])
  skill   Skill   @relation(fields: [skillId], references: [id])

  @@id([missionId, skillId])
}

model User_Has_Mission {
  userId    Int @db.Int
  slotId    Int @db.Int
  createdAt   DateTime @default(now()) @db.DateTime(45)

  user User        @relation(fields: [userId], references: [id])
  slot MissionSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@id([userId, slotId])
}

model Event_Has_Document {
  documentId Int @db.Int
  evntId     Int @db.Int
  createdAt   DateTime @default(now()) @db.DateTime(45)
  document Document @relation(fields: [documentId], references: [id])
  evnt     Evnt     @relation(fields: [evntId], references: [id], onDelete: Cascade)

  @@id([documentId, evntId])
}
