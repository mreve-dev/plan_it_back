// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

datasource db {
  provider = "mysql"
}

generator client {
  provider     = "prisma-client"
  output       = "generated/prisma"
  moduleFormat = "cjs"
}

enum RoleEnum {
  benevole
  admin
}

model User {
  id                   Int       @id @default(autoincrement())
  firstname            String
  lastname             String
  email                String    @unique
  password             String
  date_of_birth        DateTime? @db.Date
  role                 RoleEnum
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  mustChangePassword   Boolean   @default(true)
  isOnboarded          Boolean   @default(false)
  resetPasswordToken   String?
  resetPasswordExpires DateTime?

  evnts           Evnt[]             @relation("EventCreator")
  notifications   Notification[]
  userHasMissions User_Has_Mission[]
  userHasSkills   User_has_Skill[]
  updatedEvent    Evnt[]             @relation("EventUpdater")
  missions        Mission[]          @relation("MissionCreator")
  updatedMissions Mission[]          @relation("MissionUpdater")
  updatedSlots    MissionSlot[]      @relation("SlotUpdater")
}

model Evnt {
  id          Int      @id @default(autoincrement())
  name        String
  start_date  DateTime @db.Date
  end_date    DateTime @db.Date
  start_hour  DateTime @db.Time(0)
  end_hour    DateTime @db.Time(0)
  location    String?
  description String
  categoryId  Int
  creatorId   Int
  updatedById Int?
  documentId  Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  creator  User      @relation("EventCreator", fields: [creatorId], references: [id])
  updater  User?     @relation("EventUpdater", fields: [updatedById], references: [id])
  category Category  @relation(fields: [categoryId], references: [id])
  document Document? @relation(fields: [documentId], references: [id])

  missions         Mission[]
  eventHasDocument Event_Has_Document[]
}

model Mission {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  eventId     Int
  creatorId   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedById Int?

  event Evnt @relation(fields: [eventId], references: [id], onDelete: Cascade)

  creator User  @relation("MissionCreator", fields: [creatorId], references: [id])
  updater User? @relation("MissionUpdater", fields: [updatedById], references: [id])

  missionHasSkills Mission_has_Skill[]
  missionSlots     MissionSlot[]
}

model MissionSlot {
  id             Int      @id @default(autoincrement())
  date           DateTime @db.Date
  start_hour     DateTime @db.Time(0)
  end_hour       DateTime @db.Time(0)
  max_volunteers Int
  missionId      Int
  updatedById    Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  updater User? @relation("SlotUpdater", fields: [updatedById], references: [id])

  mission         Mission            @relation(fields: [missionId], references: [id], onDelete: Cascade)
  userHasMissions User_Has_Mission[]
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  evnts Evnt[]
}

model Document {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  url       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  evnts            Evnt[]
  eventHasDocument Event_Has_Document[]
}

model Notification {
  id        Int      @id @default(autoincrement())
  message   String   @unique
  date      DateTime @db.Date
  is_read   Boolean
  userId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model Skill {
  id               Int                 @id @default(autoincrement())
  name             String              @unique
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  userHasSkills    User_has_Skill[]
  missionHasSkills Mission_has_Skill[]
}

model User_has_Skill {
  userId    Int
  skillId   Int
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  skill Skill @relation(fields: [skillId], references: [id])

  @@id([userId, skillId])
}

model Mission_has_Skill {
  missionId Int
  skillId   Int
  createdAt DateTime @default(now())

  mission Mission @relation(fields: [missionId], references: [id])
  skill   Skill   @relation(fields: [skillId], references: [id])

  @@id([missionId, skillId])
}

model User_Has_Mission {
  userId    Int
  slotId    Int
  createdAt DateTime @default(now())

  user User        @relation(fields: [userId], references: [id])
  slot MissionSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@id([userId, slotId])
}

model Event_Has_Document {
  documentId Int
  evntId     Int
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id])
  evnt     Evnt     @relation(fields: [evntId], references: [id], onDelete: Cascade)

  @@id([documentId, evntId])
}
